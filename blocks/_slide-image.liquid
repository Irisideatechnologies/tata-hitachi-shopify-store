<div class="banner color-{{ block.settings.color_scheme }} media--{{ section.settings.image_height }} mobile:media--{{ section.settings.image_height_mobile }} w-full overflow-hidden" data-type="image" {{ block.shopify_attributes }}>
  <media-element class="banner__media block w-full h-full overflow-hidden"{% if section.settings.enable_parallax %} data-parallax="0.3" data-parallax-dir="{{ section.settings.parallax_direction }}"{% endif %}>
    <animate-element data-animate="zoom-out" class="media media--height block w-full h-full relative overflow-hidden" paused>
      <picture class="media media--height block w-full h-full relative overflow-hidden">
        {%- if block.settings.image != blank -%}
          {%- if block.settings.image_mobile -%}
            <source
              media="(max-width: 767px)"
              srcset="{{ block.settings.image_mobile | image_url: width: '400x' }} 400w, {{ block.settings.image_mobile | image_url: width: '600x' }} 600w, {{ block.settings.image_mobile | image_url: width: '800x' }} 800w, {{ block.settings.image_mobile | image_url: width: '1000x' }} 1000w"
              width="{{ block.settings.image_mobile.width }}"
              height="{{ block.settings.image_mobile.height }}"
            >
          {%- endif -%}

          {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: loading, fetchpriority: fetchpriority, sizes: sizes, widths: '300,400,500,600,700,800,900,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200', is: lazyimage, class: 'banner__image' -}}
        {%- else -%}
          {%- capture placeholder -%}{% cycle 'lifestyle-1', 'lifestyle-2' %}{%- endcapture -%}
          {{- placeholder | placeholder_svg_tag: 'banner__image banner__overlay placeholder' -}}
        {%- endif -%}
      </picture>
    </animate-element>
  </media-element>
  <span class="banner__overlay absolute top-0 left-0 w-full h-full pointer-events-none" style="{%- if block.settings.color_overlay != blank and block.settings.overlay_opacity != 'rgba(0,0,0,0)' -%}--color-overlay: {{ block.settings.color_overlay.rgb }};{%- endif -%}{%- if block.settings.overlay_opacity != blank -%}--overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};{%- endif -%}"></span>
  
  <div class="slider-content-width absolute top-0 left-0 w-full h-full flex justify-{{ block.settings.horizontal_alignment }}">
      {% content_for "block", type: "slide-content", id: "slide-content" %}
  </div>
</div>
{% schema %}
{
  "name": "t:blocks.image-slide.name",
  "tag": null,
  "presets": [
    {
      "name": "t:blocks.image-slide.name"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.global.settings.image.label"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.global.settings.aspect_ratio.options__1.label"
        },
        {
          "value": "square",
          "label": "t:sections.global.settings.aspect_ratio.options__2.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.global.settings.aspect_ratio.options__3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.global.settings.aspect_ratio.options__4.label"
        },
        {
          "value": "wide",
          "label": "t:sections.global.settings.aspect_ratio.options__5.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.global.settings.aspect_ratio.label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:sections.global.settings.link.label"
    },
    {
      "type": "text",
      "id": "accessibility_info",
      "label": "t:sections.global.settings.accessibility.label",
      "info": "t:sections.global.settings.accessibility.info",
      "visible_if": "{{ block.settings.link != blank }}"
    },
    {
      "type": "checkbox",
      "id": "external",
      "label": "t:sections.global.settings.button_external.label",
      "default": false
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__mobile.content"
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:sections.global.settings.image_mobile.label"
    },
    {
      "type": "select",
      "id": "aspect_ratio_mobile",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.global.settings.aspect_ratio.options__1.label"
        },
        {
          "value": "square",
          "label": "t:sections.global.settings.aspect_ratio.options__2.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.global.settings.aspect_ratio.options__3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.global.settings.aspect_ratio.options__4.label"
        },
        {
          "value": "wide",
          "label": "t:sections.global.settings.aspect_ratio.options__5.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.global.settings.aspect_ratio.label",
      "visible_if": "{{ block.settings.image_mobile != blank }}"
    },
    {
      "type": "header",
      "content": "t:blocks.group.settings.header__layout.content"
    },
    {
      "type": "select",
      "id": "horizontal_alignment",
      "label": "t:blocks.group.settings.position.label",
      "options": [
        {
          "value": "start",
          "label": "t:blocks.group.settings.alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:blocks.group.settings.alignment.options__2.label"
        },
        {
          "value": "end",
          "label": "t:blocks.group.settings.alignment.options__3.label"
        }
      ],
      "default": "start",
    },
    {
      "type": "header",
      "content": "t:blocks.group.settings.header__appearance.content"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "t:settings.color_scheme"
    },
    {
      "type": "color",
      "id": "color_overlay",
      "label": "t:sections.global.settings.color_overlay.label",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:sections.global.settings.overlay_opacity.label",
      "default": 0
    }
  ]
}
{% endschema %}
