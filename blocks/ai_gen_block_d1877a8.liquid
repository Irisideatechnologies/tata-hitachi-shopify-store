{% doc %}
  @prompt
    Show collections in carousal and new image style
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-collection-carousel-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin-inline: auto;
    color: #000000;
  }

  .ai-collection-carousel-{{ ai_gen_id }}__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }

  .ai-collection-carousel-{{ ai_gen_id }}__title {
    margin: 0;
    color: #000000;
    font-size: clamp(22px, 3vw, 36px);
    line-height: 1.15;
  }

  .ai-collection-carousel-{{ ai_gen_id }}__controls {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }

  .ai-collection-carousel-{{ ai_gen_id }}__control {
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid #333333;
    border-radius: 50%;
    background: #ffffff;
    color: #000000;
    cursor: pointer;
  }

  .ai-collection-carousel-{{ ai_gen_id }}__control:hover {
    background: #000000;
    color: #ffffff;
  }

  .ai-collection-carousel-{{ ai_gen_id }}__control:focus-visible,
  .ai-collection-carousel-{{ ai_gen_id }}__card-link:focus-visible {
    outline: 2px solid #000000;
    outline-offset: 3px;
  }

  .ai-collection-carousel-{{ ai_gen_id }}__track {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 2px 2px 12px;
  }

  .ai-collection-carousel-{{ ai_gen_id }}__track::-webkit-scrollbar {
    display: none;
  }

  .ai-collection-carousel-{{ ai_gen_id }}__card {
    flex: 0 0 calc((100% - ({{ block.settings.cards_desktop | minus: 1 }} * {{ block.settings.card_gap }}px)) / {{ block.settings.cards_desktop }});
    min-width: 0;
    scroll-snap-align: start;
  }

  .ai-collection-carousel-{{ ai_gen_id }}__card-link {
    display: block;
    color: #000000;
    text-decoration: none;
  }

  .ai-collection-carousel-{{ ai_gen_id }}__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: {{ block.settings.image_ratio }};
    border-radius: {{ block.settings.image_radius }}px;
    background: #f2f2f2;
  }

  .ai-collection-carousel-{{ ai_gen_id }}__media img,
  .ai-collection-carousel-{{ ai_gen_id }}__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-collection-carousel-{{ ai_gen_id }}__media img {
    transition: transform 250ms ease;
  }

  .ai-collection-carousel-{{ ai_gen_id }}__card-link:hover .ai-collection-carousel-{{ ai_gen_id }}__media img {
    transform: scale(1.04);
  }

  .ai-collection-carousel-{{ ai_gen_id }}__name {
    margin: 12px 0 0;
    font-size: 17px;
    line-height: 1.35;
    font-weight: 600;
  }

  .ai-collection-carousel-{{ ai_gen_id }}__empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 220px;
    padding: 16px;
    background: #f2f2f2;
    color: #333333;
    text-align: center;
  }

  .ai-collection-carousel-{{ ai_gen_id }}__empty svg {
    position: absolute;
    inset: 0;
  }

  .ai-collection-carousel-{{ ai_gen_id }}__empty-text {
    position: relative;
    z-index: 1;
    padding: 8px 12px;
    background: #ffffff;
    color: #000000;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-collection-carousel-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-collection-carousel-{{ ai_gen_id }}__card {
      flex-basis: {{ block.settings.cards_mobile }}%;
    }

    .ai-collection-carousel-{{ ai_gen_id }}__control {
      width: 38px;
      height: 38px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-collection-carousel-{{ ai_gen_id }}__track {
      scroll-behavior: auto;
    }

    .ai-collection-carousel-{{ ai_gen_id }}__media img {
      transition: none;
    }
  }
{% endstyle %}

<collection-carousel-{{ ai_gen_id }} class="ai-collection-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank or block.settings.show_controls %}
    <div class="ai-collection-carousel-{{ ai_gen_id }}__header">
      {% if block.settings.heading != blank %}
        <h2 class="ai-collection-carousel-{{ ai_gen_id }}__title">{{ block.settings.heading | escape }}</h2>
      {% else %}
        <span></span>
      {% endif %}
      {% if block.settings.show_controls %}
        <div class="ai-collection-carousel-{{ ai_gen_id }}__controls">
          <button class="ai-collection-carousel-{{ ai_gen_id }}__control" type="button" data-direction="-1" aria-label="Scroll collections backward">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m15 18-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="ai-collection-carousel-{{ ai_gen_id }}__control" type="button" data-direction="1" aria-label="Scroll collections forward">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 18 6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>
      {% endif %}
    </div>
  {% endif %}

  <div class="ai-collection-carousel-{{ ai_gen_id }}__track" data-track tabindex="0" aria-label="Collections">
    {% assign selected_collections = block.settings.collections %}
    {% if selected_collections != blank %}
      {% for collection in selected_collections %}
        <article class="ai-collection-carousel-{{ ai_gen_id }}__card">
          <a class="ai-collection-carousel-{{ ai_gen_id }}__card-link" href="{{ collection.url }}" aria-label="{{ collection.title | escape }}">
            <div class="ai-collection-carousel-{{ ai_gen_id }}__media">
              {% if collection.featured_image %}
                <img src="{{ collection.featured_image | image_url: width: 900 }}" alt="{{ collection.featured_image.alt | default: collection.title | escape }}" loading="lazy" width="{{ collection.featured_image.width }}" height="{{ collection.featured_image.height }}">
              {% elsif collection.products.first.featured_image %}
                <img src="{{ collection.products.first.featured_image | image_url: width: 900 }}" alt="{{ collection.products.first.featured_image.alt | default: collection.title | escape }}" loading="lazy" width="{{ collection.products.first.featured_image.width }}" height="{{ collection.products.first.featured_image.height }}">
              {% else %}
                <div class="ai-collection-carousel-{{ ai_gen_id }}__empty">
                  {{ 'collection-apparel-1' | placeholder_svg_tag }}
                  <span class="ai-collection-carousel-{{ ai_gen_id }}__empty-text">Add a collection image to showcase this collection</span>
                </div>
              {% endif %}
            </div>
            <h3 class="ai-collection-carousel-{{ ai_gen_id }}__name">{{ collection.title | escape }}</h3>
          </a>
        </article>
      {% endfor %}
    {% else %}
      <div class="ai-collection-carousel-{{ ai_gen_id }}__empty" style="width: 100%; position: relative;">
        {{ 'collection-apparel-1' | placeholder_svg_tag }}
        <span class="ai-collection-carousel-{{ ai_gen_id }}__empty-text">Choose collections in the block settings to display them here</span>
      </div>
    {% endif %}
  </div>
</collection-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    const tagName = 'collection-carousel-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;
    class CollectionCarousel extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.querySelectorAll('[data-direction]').forEach((button) => {
          button.addEventListener('click', () => {
            const card = this.track.querySelector('.ai-collection-carousel-{{ ai_gen_id }}__card');
            const gap = parseFloat(getComputedStyle(this.track).columnGap) || 0;
            const distance = card ? card.getBoundingClientRect().width + gap : this.track.clientWidth * 0.8;
            this.track.scrollBy({ left: distance * Number(button.dataset.direction), behavior: 'smooth' });
          });
        });
      }
    }
    customElements.define(tagName, CollectionCarousel);
  })();
</script>

{% schema %}
{
  "name": "Collection carousel",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Explore collections" },
    { "type": "collection_list", "id": "collections", "label": "Collections", "limit": 12 },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "cards_desktop", "label": "Cards on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "select", "id": "cards_mobile", "label": "Card width on mobile", "options": [{ "value": "75", "label": "Peek next card" }, { "value": "90", "label": "Nearly full width" }, { "value": "100", "label": "Full width" }], "default": "75" },
    { "type": "select", "id": "image_ratio", "label": "Image shape", "options": [{ "value": "1 / 1", "label": "Square" }, { "value": "4 / 5", "label": "Portrait" }, { "value": "16 / 9", "label": "Landscape" }], "default": "4 / 5" },
    { "type": "range", "id": "image_radius", "label": "Image corner radius", "min": 0, "max": 32, "step": 2, "unit": "px", "default": 8 },
    { "type": "range", "id": "card_gap", "label": "Space between cards", "min": 8, "max": 40, "step": 4, "unit": "px", "default": 16 },
    { "type": "checkbox", "id": "show_controls", "label": "Show arrow controls", "default": true }
  ],
  "presets": [
    { "name": "Collection carousel" }
  ],
  "tag": null,
  "class": "collection-carousel-block"
}
{% endschema %}