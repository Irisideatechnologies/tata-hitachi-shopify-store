{%- capture image_content -%}
  {%- assign classes = 'w-full aspect-' | append: block.settings.aspect_ratio -%}
  <picture class="media block relative kitify-banner__img w-full">
    {%- if block.settings.image != blank -%}
      {%- assign sizes = 'auto, (min-width: 768px) 100vw, 100vw' -%}
      {%- if block.settings.image_mobile -%}
        {%- assign classes = classes | append: ' mobile:aspect-' | append: block.settings.aspect_ratio_mobile -%}
        <source
          media="(max-width: 767px)"
          srcset="{{ block.settings.image_mobile | image_url: width: '400x' }} 400w, {{ block.settings.image_mobile | image_url: width: '600x' }} 600w, {{ block.settings.image_mobile | image_url: width: '800x' }} 800w, {{ block.settings.image_mobile | image_url: width: '1000x' }} 1000w"
          width="{{ block.settings.image_mobile.width }}"
          height="{{ block.settings.image_mobile.height }}"
        >
      {%- endif -%}

      {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', sizes: sizes, widths: '300,400,500,600,700,800,900,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200', is: 'lazy-image', class: classes -}}
    {%- else -%}
      {%- assign classes = classes | append: ' placeholder placeholder--transparent' -%}
      {{- 'collection-1' | placeholder_svg_tag: classes -}}
    {%- endif -%}
  </picture>
{%- endcapture -%}
<figure class="kitify-banner rounded-banner block-position-{{ block.settings.heading_position }} size-style border-style overflow-hidden color-{{ block.settings.color_scheme }}" style="{% render 'section-size-style', settings: block.settings %}{% render 'section-border-style', settings: block.settings %}" {{ block.shopify_attributes }}>
        <div class="kitify-banner__overlay z-1" style="{%- if block.settings.color_overlay != blank and block.settings.overlay_opacity != 'rgba(0,0,0,0)' -%}--color-overlay: {{ block.settings.color_overlay.rgb }};{%- endif -%}{%- if block.settings.overlay_opacity != blank -%}--overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};{%- endif -%}"></div>
        <a class="kitify-banner__link absolute z-9 w-full h-full" href="{{ block.settings.button_link }}" target="{{ block.settings.button_external | default: '_self' }}"></a>
        {{- image_content -}}
          {%- liquid
            assign heading_position_class = 'position-top-left left-0 top-0'
            if block.settings.heading_position == 'top-right'
              assign heading_position_class = 'position-top-right right-0 top-0'
            elsif block.settings.heading_position == 'bottom-left'
              assign heading_position_class = 'position-bottom-left left-0 bottom-0'
            elsif block.settings.heading_position == 'bottom-right'
              assign heading_position_class = 'position-bottom-right right-0 bottom-0'
            endif
            assign items_alginment = 'items-start'
            if block.settings.heading_position == 'top-right' or block.settings.heading_position == 'bottom-right'
              assign items_alginment = 'items-end'
            endif
          -%}
          <div class="absolute z-10 {{ heading_position_class }} pointer-events-none">
            <div class="flex flex-col {{ items_alginment }} w-full h-full">
              {%- liquid
                assign has_subheading = false
                if block.settings.subheading != blank
                  assign has_subheading = true
                endif
              -%}
              {%- if has_subheading -%}
                <div class="rounded-content w-fit sub-heading">
                  <div class="rounded-content-inner">
                    <svg class="svg-conner corner-before" width="20" height="20">
                        <path d="M0 0 L20 0 C8.95 0 0 8.95 0 20 Z" fill="currentColor"/>
                    </svg>
                    <p class="section__subheading text-sm text-opacity uppercase tracking-widest opacity-80">{{ block.settings.subheading }}</p>
                    <svg class="svg-conner corner-after" width="20" height="20">
                        <path d="M0 0 L20 0 C8.95 0 0 8.95 0 20 Z" fill="currentColor"/>
                    </svg>
                  </div>
                </div>
              {%- endif -%}
              {%- if block.settings.heading != blank -%}
                <div class="rounded-content w-fit end">
                  <div class="rounded-content-inner">
                    <svg class="svg-conner corner-before" width="20" height="20">
                        <path d="M0 0 L20 0 C8.95 0 0 8.95 0 20 Z" fill="currentColor"/>
                    </svg>
                    <{{ block.settings.heading_tag }} class="section__heading text-2xl font-medium">{{ block.settings.heading }}</{{ block.settings.heading_tag }}>
                      <svg class="svg-conner corner-after" width="20" height="20" ...>
                        <path d="M0 0 L20 0 C8.95 0 0 8.95 0 20 Z" fill="currentColor"/>
                      </svg>
                  </div>
                </div>
              {%- endif -%}
            </div>
          </div>
</figure>
