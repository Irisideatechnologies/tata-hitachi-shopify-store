{%- capture image_content -%}
  {%- assign classes = 'w-full aspect-' | append: block.settings.aspect_ratio -%}
  <picture class="media block relative kitify-banner__img w-full">
    {%- if block.settings.image != blank -%}
      {%- assign sizes = 'auto, (min-width: 768px) 100vw, 100vw' -%}
      {%- if block.settings.image_mobile -%}
        {%- assign classes = classes | append: ' mobile:aspect-' | append: block.settings.aspect_ratio_mobile -%}
        <source
          media="(max-width: 767px)"
          srcset="{{ block.settings.image_mobile | image_url: width: '400x' }} 400w, {{ block.settings.image_mobile | image_url: width: '600x' }} 600w, {{ block.settings.image_mobile | image_url: width: '800x' }} 800w, {{ block.settings.image_mobile | image_url: width: '1000x' }} 1000w"
          width="{{ block.settings.image_mobile.width }}"
          height="{{ block.settings.image_mobile.height }}"
        >
      {%- endif -%}

      {{- block.settings.image | image_url: width: block.settings.image.width | image_tag: loading: 'lazy', sizes: sizes, widths: '300,400,500,600,700,800,900,1000,1200,1400,1600,1800,2000,2200,2400,2600,2800,3000,3200', is: 'lazy-image', class: classes -}}
    {%- else -%}
      {%- assign classes = classes | append: ' placeholder placeholder--transparent' -%}
      {{- 'collection-1' | placeholder_svg_tag: classes -}}
    {%- endif -%}
  </picture>
{%- endcapture -%}
<figure class="kitify-banner rounded-banner style-button-{{ block.settings.button_alignment }} size-style border-style overflow-hidden color-{{ block.settings.color_scheme }}" style="{% render 'section-size-style', settings: block.settings %}{% render 'section-border-style', settings: block.settings %}" {{ block.shopify_attributes }}>
        <div class="kitify-banner__overlay z-1" style="{%- if block.settings.color_overlay != blank and block.settings.overlay_opacity != 'rgba(0,0,0,0)' -%}--color-overlay: {{ block.settings.color_overlay.rgb }};{%- endif -%}{%- if block.settings.overlay_opacity != blank -%}--overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};{%- endif -%}"></div>
        {{- image_content -}}
      <figcaption class="kitify-banner__content z-3">
        <div class="image-card-button-wrapper">
          <div class="image-card-button-inner">
            <div class="button-padding {{ block.settings.button_style }}">
            {%- if block.settings.button_label != blank -%}
              {%- render 'button',
                label: block.settings.button_label,
                link: block.settings.button_link,
                size: block.settings.button_size,
                style: block.settings.button_style,
                external: block.settings.button_external,
                show_icon: block.settings.button_icon,
                icon_only: block.settings.button_icon_only,
                shopify_attributes: block.shopify_attributes,
                size_style: '',
                classes: ''
              -%}
            {%- endif -%}
          </div>
          </div>
        </div>
      </figcaption>
      <figcaption class="kitify-banner__blocks_content absolute z-2 left-0 top-0 w-full h-full p-4 md:p-4 lg:p-8">
        {% content_for 'blocks' %}
      </figcaption>
</figure>

{% schema %}
{
  "name": "t:blocks.image-card.name",
  "tag": null,
  "blocks": [
      { "type": "base-heading" },
      { "type": "text" },
      { "type": "spacer" }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:sections.global.settings.image.label"
    },
    {
      "type": "select",
      "id": "aspect_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:sections.global.settings.aspect_ratio.options__1.label"
        },
        {
          "value": "square",
          "label": "t:sections.global.settings.aspect_ratio.options__2.label"
        },
        {
          "value": "portrait",
          "label": "t:sections.global.settings.aspect_ratio.options__3.label"
        },
        {
          "value": "landscape",
          "label": "t:sections.global.settings.aspect_ratio.options__4.label"
        },
        {
          "value": "wide",
          "label": "t:sections.global.settings.aspect_ratio.options__5.label"
        }
      ],
      "default": "adapt",
      "label": "t:sections.global.settings.aspect_ratio.label"
    },
    {
      "type": "header",
      "content": "t:options.button"
    },
    {
      "type": "select",
      "id": "button_alignment",
      "label": "t:blocks.group.settings.alignment.label",
      "options": [
        {
          "value": "left",
          "label": "t:blocks.group.settings.alignment.options__1.label"
        },
        {
          "value": "right",
          "label": "t:blocks.group.settings.alignment.options__3.label"
        }
      ],
      "default": "left",
    },
    {
      "type": "text",
      "id": "button_label",
      "default": "Button label",
      "label": "t:sections.global.settings.button_label.label",
      "info": "t:sections.global.settings.button_label.info"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:sections.global.settings.button_link.label"
    },
    {
      "type": "select",
      "id": "button_style",
      "options": [
        {
          "value": "primary",
          "label": "t:sections.global.settings.button_style.options__1.label"
        },
        {
          "value": "secondary",
          "label": "t:sections.global.settings.button_style.options__2.label"
        },
        {
          "value": "link",
          "label": "t:sections.global.settings.button_style.options__3.label"
        }
      ],
      "default": "link",
      "label": "t:sections.global.settings.button_style.label"
    },
    {
      "type": "checkbox",
      "id": "button_external",
      "label": "t:sections.global.settings.button_external.label",
