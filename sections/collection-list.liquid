<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .collection-card--circle a {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    text-decoration: none;
    color: inherit;
    gap: 1rem;
  }

  #shopify-section-{{ section.id }} .collection-circle-image {
    width: 100%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    background: #f2f2f2;
  }

  #shopify-section-{{ section.id }} .collection-circle-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
  }

  #shopify-section-{{ section.id }} .collection-card--circle .circle-title {
    font-weight: 500;
    font-size: var(--text-lg);
  }

  #shopify-section-{{ section.id }} .collection-card--circle .circle-count {
    opacity: 0.5;
    margin-top: 0.25rem;
  }

  #shopify-section-{{ section.id }} .collection-card--circle a:hover .collection-circle-image {
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  @media screen and (min-width: 1280px) {
    #shopify-section-{{ section.id }} .card-grid--6 {
      --card-grid-per-row: 5;
    }
  }

  @media screen and (min-width: 1536px) {
    #shopify-section-{{ section.id }} .card-grid--6 {
      --card-grid-per-row: 6;
    }
  }
</style>

<div class="section section--padding">
  <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %} relative">
    {%- capture view_all -%}
      {%- if section.settings.show_view_all and section.blocks.size < collections.size -%}
        <a class="btn btn--secondary icon-with-text" href="{{ routes.collections_url }}" is="hover-link">
          
          <span class="btn-text">
            {%- liquid
              render 'icon', icon: 'newspaper'
              echo 'sections.collection_list.view_all' | t
            -%}
          </span>
        </a>
      {%- endif -%}
    {%- endcapture -%}
    {%- render 'section-heading', section: section -%}

    <slider-element id="Slider-{{ section.id }}" class="grid slider{% if section.settings.carousel_on_desktop %} slider--desktop{% endif %}{% if section.settings.swipe_on_mobile %} slider--tablet{% endif %}" selector=".card-grid>.card"{% if section.settings.carousel_on_desktop or section.settings.swipe_on_mobile %} tabindex="0"{% endif %}>
      <motion-list class="card-grid card-grid--{{ section.settings.columns }} mobile:card-grid--{{ section.settings.columns_mobile }} grid">
        {%- for block in section.blocks -%}
          {%- assign collection = collections[block.settings.collection] -%}
          {%- render 'collection-card',
            block: block,
            collection: collection,
            card_style: section.settings.card_style,
            image_type: section.settings.image_type,
            image_ratio: section.settings.image_ratio,
            show_products_count: section.settings.show_products_count,
            position: forloop.index
          -%}
        {%- endfor -%}
      </motion-list>

        {%- if section.settings.carousel_on_desktop -%}
          <div class="indicators hidden lg:flex gap-2d5 items-center absolute top-0 left-0 w-full h-full pointer-events-none opacity-0 page-width">
            <button class="btn btn--white pointer-events-auto" type="button" is="previous-button" aria-controls="Slider-{{ section.id }}" aria-label="{{ 'general.pagination.previous' | t | escape }}" disabled tabindex="-1">
              
              <span class="btn-text">
                {%- render 'icon', icon: 'chevron-left', class: 'stroke-2 transform' -%}
              </span>
            </button>
            <button class="btn btn--white pointer-events-auto" type="button" is="next-button" aria-controls="Slider-{{ section.id }}" aria-label="{{ 'general.pagination.next' | t | escape }}" tabindex="-1">
              
              <span class="btn-text">
                {%- render 'icon', icon: 'chevron-right', class: 'stroke-2 transform' -%}
              </span>
            </button>
          </div>
        {%- endif -%}
    </slider-element>

    {%- if section.settings.carousel_on_desktop -%}
      <p class="hidden lg:block">{{ view_all }}</p>
    {%- endif -%}
  </div>
</div>

