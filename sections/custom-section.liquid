        }
      ],
      "default": "cover",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:blocks.group.settings.background_color.label",
      "alpha": true,
      "default": "rgba(0,0,0,0)",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "select",
      "id": "background_repeat",
      "label": "t:blocks.group.settings.background_repeat.label",
      "options": [
        { "value": "no-repeat", "label": "t:blocks.group.settings.background_repeat.options__1.label" },
        { "value": "repeat",    "label": "t:blocks.group.settings.background_repeat.options__2.label" },
        { "value": "repeat-x",  "label": "t:blocks.group.settings.background_repeat.options__3.label" },
        { "value": "repeat-y",  "label": "t:blocks.group.settings.background_repeat.options__4.label" },
        { "value": "space",     "label": "t:blocks.group.settings.background_repeat.options__5.label" },
        { "value": "round",     "label": "t:blocks.group.settings.background_repeat.options__6.label" }
      ],
      "default": "no-repeat",
      "visible_if": "{{ section.settings.background_media == 'image' }}"
    },
    {
      "type": "select",
      "id": "background_size",
      "label": "t:blocks.group.settings.background_size.label",
      "options": [
        { "value": "auto",    "label": "t:blocks.group.settings.background_size.options__1.label" },
        { "value": "cover",   "label": "t:blocks.group.settings.background_size.options__2.label" },
        { "value": "contain", "label": "t:blocks.group.settings.background_size.options__3.label" }
      ],
      "default": "auto",
      "visible_if": "{{ section.settings.background_media == 'image' and section.settings.background_repeat != 'no-repeat' }}"
    },
    {
      "type": "checkbox",
      "id": "toggle_overlay",
      "label": "t:blocks.group.settings.background_overlay.label"
