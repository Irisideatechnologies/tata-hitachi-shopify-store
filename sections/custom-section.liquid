        },
        {
          "value": "to bottom",
          "label": "t:blocks.group.settings.gradient_direction.options__2.label"
        }
      ],
      "default": "to top",
      "visible_if": "{{ section.settings.toggle_overlay and section.settings.overlay_style == 'gradient' }}"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__section.content"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "t:sections.global.settings.padding_top.label",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "label": "t:sections.global.settings.padding_bottom.label",
      "default": 72
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__mobile.content"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "t:sections.global.settings.hide_on_mobile.label",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:sections.custom-section.name",
      "category": "t:categories.layout"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
