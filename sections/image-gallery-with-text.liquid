<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #ImageGallery-{{ section.id }} {
    columns: {{ section.settings.columns_mobile }};
    column-gap: 12px;
  }

  @media screen and (min-width: 640px) {
    #ImageGallery-{{ section.id }} {
      columns: {{ section.settings.columns }};
    }
  }

  #ImageGallery-{{ section.id }} .image-gallery-with-text__item img {
    will-change: transform;
    transition: transform 0.65s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  #ImageGallery-{{ section.id }} .image-gallery-with-text__item:hover img {
    transform: scale(1.08);
  }

  #shopify-section-{{ section.id }} .gallery-carousel-nav {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    pointer-events: none;
    padding: 0 0.5rem;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .gallery-carousel-nav .btn {
    pointer-events: auto;
  }

  #shopify-section-{{ section.id }} .gallery-carousel-item .media {
    overflow: hidden;
    border-radius: 0.75rem;
  }

  #shopify-section-{{ section.id }} .gallery-carousel-item img {
    will-change: transform;
    transition: transform 0.65s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  #shopify-section-{{ section.id }} .gallery-carousel-item:hover img {
    transform: scale(1.05);
  }

  @media screen and (min-width: 1280px) {
    #shopify-section-{{ section.id }} .card-grid--5 {
      --card-grid-per-row: 5;
    }
    #shopify-section-{{ section.id }} .card-grid--6 {
      --card-grid-per-row: 6;
    }
  }
</style>

{%- liquid
  case section.settings.image_ratio
    when 'square'
      assign ratio_style = 'aspect-ratio: 1/1;'
    when 'portrait'
      assign ratio_style = 'aspect-ratio: 2/3;'
    when 'landscape'
      assign ratio_style = 'aspect-ratio: 4/3;'
    when 'wide'
      assign ratio_style = 'aspect-ratio: 16/9;'
    else
      assign ratio_style = ''
  endcase

  if ratio_style != ''
    assign img_class = 'w-full h-full object-cover absolute inset-0'
  else
    assign img_class = 'w-full block'
  endif
-%}

<div class="section section--padding color-{{ section.settings.color_scheme }}">
  <div class="page-width relative">

    {%- if section.settings.layout == 'carousel' -%}

      {%- comment -%} Carousel layout: centered text above + full-width slider {%- endcomment -%}
      <div class="gallery-carousel-header text-center mb-10">
        {%- if section.settings.subheading != blank -%}
          <p class="heading uppercase font-medium subtext-md leading-none tracking-widest mb-4">
            {{- section.settings.subheading | escape -}}
          </p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="heading {{ section.settings.heading_size }} leading-tight mb-4">
            {%- render 'heading-content', content: section.settings.heading -%}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="rte description leading-normal subtext-md mb-8">
            {{- section.settings.description -}}
          </div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <p>
            {%- render 'button',
              label: section.settings.button_label,
              link: section.settings.button_link,
              size: section.settings.button_size,
              style: section.settings.button_style,
              external: section.settings.button_external,
              show_icon: section.settings.button_icon,
              icon: section.settings.button_icon_name
            -%}
          </p>
        {%- endif -%}
      </div>

      {%- if section.blocks.size > 0 -%}
        <div class="relative">
          <slider-element id="Slider-{{ section.id }}" class="grid slider slider--desktop slider--tablet" selector=".gallery-slider-grid>.gallery-carousel-item" tabindex="0">
            <gallery-lightbox class="gallery-slider-grid card-grid card-grid--{{ section.settings.columns }} mobile:card-grid--{{ section.settings.columns_mobile }} grid">
              {%- for block in section.blocks -%}
                {%- if block.settings.image != blank -%}
                  {%- liquid
                    assign img_url = block.settings.image | image_url: width: block.settings.image.width
                  -%}
                  <a
                    href="{{ img_url }}"
                    data-pswp-src="{{ img_url }}"
                    data-pswp-width="{{ block.settings.image.width }}"
                    data-pswp-height="{{ block.settings.image.height }}"
                    data-pswp-srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1600 }} 1600w, {{ block.settings.image | image_url: width: block.settings.image.width }} {{ block.settings.image.width }}w"
                    class="gallery-carousel-item block relative group cursor-zoom-in"
                    aria-label="{{ block.settings.image.alt | default: 'Image ' | append: forloop.index | escape }}"
                    {{ block.shopify_attributes }}
                  >
                    <div class="media relative overflow-hidden rounded-xl"{% if ratio_style != '' %} style="{{ ratio_style }}"{% endif %}>
                      {{- block.settings.image | image_url: width: 600 | image_tag:
                        loading: 'lazy',
                        widths: '300,400,500,600,700,800',
                        sizes: '(max-width: 639px) 80vw, (max-width: 1023px) 40vw, 30vw',
                        is: 'lazy-image',
                        class: img_class
                      -}}
                      <div class="absolute right-0 bottom-0">
                        <div class="creative-rounded-icon flex justify-end">
                          <div class="icon-rounded-inner">
                            <div class="button__icon flex items-center justify-center rounded-full size-8 shrink-0">
                              {%- render 'icon-guarantee', icon: section.settings.image_icon, size: 'xs' -%}
                            </div>
                          </div>
                        </div>
                      </div>
                    </div>
                    {%- if block.settings.caption != blank -%}
                      <span class="sr-only">{{ block.settings.caption | escape }}</span>
                    {%- endif -%}
                  </a>
                {%- else -%}
                  <div class="gallery-carousel-item block overflow-hidden rounded-xl" {{ block.shopify_attributes }}>
                    <div{% if ratio_style != '' %} style="{{ ratio_style }}"{% endif %}>
                      {{- 'product-1' | placeholder_svg_tag: 'placeholder w-full' -}}
                    </div>
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </gallery-lightbox>

            <div class="gallery-carousel-nav">
              <button class="btn btn--white" type="button" is="previous-button" aria-controls="Slider-{{ section.id }}" aria-label="{{ 'general.pagination.previous' | t | escape }}" disabled>
                <span class="btn-text">{%- render 'icon', icon: 'chevron-left', class: 'stroke-2' -%}</span>
              </button>
              <button class="btn btn--white" type="button" is="next-button" aria-controls="Slider-{{ section.id }}" aria-label="{{ 'general.pagination.next' | t | escape }}">
                <span class="btn-text">{%- render 'icon', icon: 'chevron-right', class: 'stroke-2' -%}</span>
              </button>
            </div>
          </slider-element>
        </div>
      {%- endif -%}

    {%- else -%}

      {%- comment -%} Default layout: side text + masonry grid {%- endcomment -%}
      <div class="image-gallery-with-text flex flex-col gap-10 lg:gap-20{% if section.settings.layout == 'image_first' %} lg:flex-row-reverse{% else %} lg:flex-row{% endif %} lg:items-center">

        <div class="image-gallery-with-text__content shrink-0 lg:w-[38%]">
          {%- if section.settings.subheading != blank -%}
            <p class="heading uppercase font-medium subtext-md leading-none tracking-widest mb-4">
              {{- section.settings.subheading | escape -}}
            </p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <{{ section.settings.heading_tag }} class="heading {{ section.settings.heading_size }} leading-tight mb-4">
              {%- render 'heading-content', content: section.settings.heading -%}
            </{{ section.settings.heading_tag }}>
          {%- endif -%}
          {%- if section.settings.description != blank -%}
            <div class="rte description leading-normal subtext-md mb-8">
              {{- section.settings.description -}}
            </div>
          {%- endif -%}
          {%- if section.settings.button_label != blank -%}
            <p>
              {%- render 'button',
                label: section.settings.button_label,
                link: section.settings.button_link,
                size: section.settings.button_size,
                style: section.settings.button_style,
                external: section.settings.button_external,
                show_icon: section.settings.button_icon,
                icon: section.settings.button_icon_name
              -%}
            </p>
          {%- endif -%}
        </div>

        {%- if section.blocks.size > 0 -%}
          <gallery-lightbox id="ImageGallery-{{ section.id }}" class="image-gallery-with-text__grid grow">
            {%- for block in section.blocks -%}
              {%- if block.settings.image != blank -%}
                {%- liquid
                  assign img_url = block.settings.image | image_url: width: block.settings.image.width
                -%}
                <a
                  href="{{ img_url }}"
                  data-pswp-src="{{ img_url }}"
                  data-pswp-width="{{ block.settings.image.width }}"
                  data-pswp-height="{{ block.settings.image.height }}"
                  data-pswp-srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 800 }} 800w, {{ block.settings.image | image_url: width: 1200 }} 1200w, {{ block.settings.image | image_url: width: 1600 }} 1600w, {{ block.settings.image | image_url: width: block.settings.image.width }} {{ block.settings.image.width }}w"
                  class="image-gallery-with-text__item break-inside-avoid block overflow-hidden rounded-lg relative group cursor-zoom-in mb-3"
                  aria-label="{{ block.settings.image.alt | default: 'Image ' | append: forloop.index | escape }}"
                  {{ block.shopify_attributes }}
                >
                  <div class="media relative overflow-hidden rounded-lg{% if ratio_style != '' %} relative{% endif %}"{% if ratio_style != '' %} style="{{ ratio_style }}"{% endif %}>
                    {{- block.settings.image | image_url: width: 600 | image_tag:
                      loading: 'lazy',
                      widths: '300,400,500,600,700,800',
                      sizes: '(max-width: 767px) 45vw, (max-width: 1023px) 30vw, 20vw',
                      is: 'lazy-image',
                      class: img_class
                    -}}
                    <div class="absolute right-0 bottom-0">
                      <div class="creative-rounded-icon flex justify-end">
                        <div class="icon-rounded-inner">
                          <div class="button__icon flex items-center justify-center rounded-full size-8 shrink-0">
                            {%- render 'icon-guarantee', icon: section.settings.image_icon, size: 'xs' -%}
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                  {%- if block.settings.caption != blank -%}
                    <span class="sr-only">{{ block.settings.caption | escape }}</span>
                  {%- endif -%}
                </a>
              {%- else -%}
                <div class="image-gallery-with-text__item break-inside-avoid block overflow-hidden rounded-lg mb-3" {{ block.shopify_attributes }}>
                  <div{% if ratio_style != '' %} style="{{ ratio_style }}"{% endif %}>
                    {{- 'product-1' | placeholder_svg_tag: 'placeholder w-full' -}}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
          </gallery-lightbox>
        {%- endif -%}

      </div>

    {%- endif -%}

  </div>
</div>

