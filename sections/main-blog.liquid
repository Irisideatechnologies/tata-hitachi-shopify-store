<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .blog-tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    justify-content: center;
    margin-top: 4px;
  }

  #shopify-section-{{ section.id }} .blog-tag-filter__item {
    display: inline-flex;
    align-items: center;
    padding: 6px 18px;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    border: 1.5px solid rgb(var(--color-foreground) / 0.2);
    color: rgb(var(--color-foreground) / 0.6);
    background: transparent;
    text-decoration: none;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .blog-tag-filter__item:hover {
    border-color: rgb(var(--color-foreground) / 0.6);
    color: rgb(var(--color-foreground));
    background: rgb(var(--color-foreground) / 0.04);
  }

  #shopify-section-{{ section.id }} .blog-tag-filter__item.is-active {
    background: rgb(var(--color-foreground));
    border-color: rgb(var(--color-foreground));
    color: rgb(var(--color-background));
  }
</style>

{{ 'blog.css' | asset_url | stylesheet_tag }}
{{ 'collection.css' | asset_url | stylesheet_tag }}
<script src="{{ 'collection.js' | asset_url }}" defer></script>

{%- paginate blog.articles by section.settings.per_page -%}
  <div class="section section--padding color-{{ section.settings.color_scheme }}" id="shopify-section-{{ section.id }}" data-section-id="{{ section.id }}" data-section-type="main-blog">
    <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %} relative">
      <div class="title-wrapper{% if section.settings.heading_size == 'title-xl' %} title-wrapper-lg{% endif %} {{ section.settings.heading_alignment }} flex flex-col gap-8">
        {%- if section.settings.subheading != blank -%}
          {%- liquid
            if section.settings.heading_size == 'title-sm'
              assign subtext_size = 'subtext-md'
            else
              assign subtext_size = 'subtext-lg'
            endif
          -%}
          <p class="heading normal-case font-medium {{ subtext_size }} leading-none tracking-none">
            {{- section.settings.subheading | escape -}}
          </p>
        {%- endif -%}

        <{{ section.settings.heading_tag }} class="heading {{ section.settings.heading_size }}">
          {%- render 'heading-content', content: blog.title, style: 'none' -%}
        </{{ section.settings.heading_tag }}>

        {%- if section.settings.description != blank -%}
          {%- liquid
            if section.settings.heading_size == 'title-sm' or section.settings.heading_size == 'title-md'
              assign subtext_size = 'subtext-md'
            else
              assign subtext_size = 'subtext-lg'
            endif
          -%}
          <div class="inline-flex justify-center rte">
            <div class="page-width--narrow rte leading-normal {{ subtext_size }}">{{ section.settings.description }}</div>
          </div>
        {%- endif -%}

        {%- if section.settings.show_tag_filter and blog.tags.size > 0 -%}
          <div class="blog-tag-filter">
            <a href="{{ blog.url }}" class="blog-tag-filter__item{% if current_tags == blank %} is-active{% endif %}">
              {{ 'blogs.article.all_tags' | t }}
            </a>
            {%- for tag in blog.all_tags -%}
              <a href="{{ blog.url }}/tagged/{{ tag | handleize }}" class="blog-tag-filter__item{% if current_tags contains tag %} is-active{% endif %}" aria-label="{{ 'blogs.article.view_posts_tagged' | t: tag: tag | escape }}">
                {{ tag }}
              </a>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="blog flex flex-col gap-12">
        <motion-list class="blog-grid{% if section.settings.layout == 'collage' %} blog-collage{% if blog.articles_count == 1 %} with-only1{% endif %}{% endif %} card-grid card-grid--3 mobile:card-grid--1 grid">
          {%- for article in blog.articles reversed -%}
            {%- if section.settings.layout == 'collage' and forloop.first -%}
              {%- capture sizes -%}100vw{%- endcapture -%}
            {%- else -%}
              {%- capture sizes -%}(max-width: 639px) 100vw, (max-width: 767px) 74vw, {{ settings.page_width | divided_by: 3 }}px{%- endcapture -%}
            {%- endif -%}

            {%- render 'article-card',
              article: article,
              blog: blog,
              sizes: sizes,
              image_ratio: section.settings.image_ratio,
              show_tags: section.settings.show_tags,
              show_date: section.settings.show_date,
              show_author: section.settings.show_author,
              show_comments: section.settings.show_comments,
              show_excerpt: section.settings.show_excerpt,
            -%}
          {%- endfor -%}
        </motion-list>

        {%- liquid
          if paginate.pages > 1
            render 'pagination', paginate: paginate
          endif
        -%}
      </div>
    </div>
  </div>
{%- endpaginate -%}

{% schema %}
{
