{%- liquid
  assign rounded_slide_corners = false
  if section.settings.section_width == 'page_width'
    assign rounded_slide_corners = true
  endif  
  assign first_block = section.blocks | first
  if first_block != blank
    assign first_block_image = first_block.settings.image
    if first_block.type == 'video'
      assign first_block_image = first_block.settings.video.preview_image | default: first_block.settings.cover_image
    endif

    assign first_block_image_mobile = first_block.settings.image_mobile | default: first_block_image
    if first_block.type == 'video'
      assign first_block_image_mobile = first_block.settings.video_mobile.preview_image | default: first_block.settings.cover_image_mobile
    endif
  endif
-%}
<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- if first_block_image != blank and section.settings.image_height == 'adapt' %}
      --ratio-percent: {{ 1 | divided_by: first_block_image.aspect_ratio | times: 100 }}%;
    {% endif -%}
  }

  {%- if first_block_image_mobile != blank and section.settings.image_height_mobile == 'adapt' %}
    @media screen and (max-width: 767px) {
      #shopify-section-{{ section.id }} {
        --ratio-percent: {{ 1 | divided_by: first_block_image_mobile.aspect_ratio | times: 100 }}%;
      }
    }
  {% endif -%}
  
</style>

{%- if section.blocks.size > 0 -%}
<div class="section section--padding{% if section.settings.section_width== 'full_width' %} slider-full-width{% endif %}" style="{% if rounded_slide_corners %}--corner-radius: {{ section.settings.corner_radius }}px;{% endif %}">
  <div class="{% unless section.settings.section_width== 'full_width' %}page-width {% endunless %}">
    <div class="relative">
      {%- if section.blocks.size > 1 and section.settings.autoplay -%}
        <button
          type="button"
          class="slideshow-control flex items-center justify-center rounded-full sr-only"
          is="control-button"
          aria-controls="Slider-{{ section.id }}"
          aria-live="polite"
          aria-label="{{ 'sections.slideshow.pause_slideshow' | t | escape }}"
          data-pause-label="{{ 'sections.slideshow.pause_slideshow' | t | escape }}"
          data-play-label="{{ 'sections.slideshow.play_slideshow' | t | escape }}"
        >
          <span class="slideshow-control__pause">
            {%- render 'icon', icon: 'pause' -%}
          </span>
          <span class="slideshow-control__play">
            {%- render 'icon', icon: 'play' -%}
          </span>
        </button>
      {%- endif -%}
      <slideshow-element
        id="Slider-{{ section.id }}" class="slideshow block"{% if section.settings.autoplay %} autoplay autoplay-speed="{{ section.settings.autoplay_speed }}"{% endif %}
        role="region"
        aria-roledescription="{{ 'sections.slideshow.carousel' | t }}"
        aria-label="{{ section.settings.accessibility_info | escape }}"
      >
        {%- capture sizes -%}{% if section.settings.section_width == 'full_width' %}100vw{% else %}min({{ settings.page_width }}px, 100vw){% endif %}{%- endcapture -%}
        {% for block in section.blocks %}
          {% render block %}
        {% endfor %}
      </slideshow-element>
      {%- if section.blocks.size > 1 and section.settings.show_navigation -%}
      <div class="slideshow-button absolute top-0 left-6 flex items-center h-full">
        <button type="button" is="previous-button" class="absolute left-0 hidden md:flex pointer-events-auto items-center justify-center rounded-full" aria-controls="Slider-{{ section.id }}" aria-label="{{ 'general.pagination.previous' | t | escape }}">
          {%- render 'icon', icon: 'arrow-left', class: 'transform' -%}
        </button>
      </div>
      <slider-dots class="flickity-page-dots absolute bottom-4 w-auto pointer-events-auto" aria-controls="Slider-{{ section.id }}">
        {%- for block in section.blocks -%}
          <button type="button" class="flickity-page-dot" data-index="{{ forloop.index0 }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
            <span class="sr-only">{{ 'general.pagination.page' | t: number: forloop.index }}</span>
          </button>
        {%- endfor -%}
      </slider-dots>
      <div class="slideshow-button absolute top-0 right-6 flex items-center h-full">
        <button type="button" is="next-button" class="absolute right-0 hidden md:flex pointer-events-auto items-center justify-center rounded-full" aria-controls="Slider-{{ section.id }}" aria-label="{{ 'general.pagination.next' | t | escape }}">
          {%- render 'icon', icon: 'arrow-right', class: 'transform' -%}
        </button>
      </div>
      {% endif -%}
   </div>
</div>
</div>
{%- endif -%}

