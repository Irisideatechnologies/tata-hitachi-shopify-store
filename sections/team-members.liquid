<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .team-card__media {
    border-radius: {{ section.settings.card_radius }}px;
    overflow: hidden;
    position: relative;
  }

  #shopify-section-{{ section.id }} .team-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }

  #shopify-section-{{ section.id }} .team-card:hover .team-card__media img {
    transform: scale(1.05);
  }

  #shopify-section-{{ section.id }} .team-card__overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
  }

  #shopify-section-{{ section.id }} .team-card__role {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    display: block;
    margin-bottom: 2px;
  }

  #shopify-section-{{ section.id }} .team-card__overlay-name {
    font-size: 0.95rem;
    font-weight: 600;
    display: block;
  }

  #shopify-section-{{ section.id }} .team-card__info {
    padding-top: 12px;
  }

  #shopify-section-{{ section.id }} .team-card__name {
    font-size: 1rem;
    font-weight: 600;
    color: rgb(var(--color-foreground));
    display: block;
  }

  #shopify-section-{{ section.id }} .team-card__role-below {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgb(var(--color-foreground) / 0.5);
    display: block;
    margin-bottom: 4px;
  }
</style>

<div class="section team-members-section section--padding color-{{ section.settings.color_scheme }}">
  <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %} relative">
    {%- render 'section-heading', section: section -%}

    {%- if section.blocks.size > 0 -%}
      <slider-element id="Slider-{{ section.id }}" class="grid slider{% if section.settings.layout == 'slider' %} slider--desktop{% endif %} slider--tablet" selector=".team-grid>.team-card"{% if section.settings.layout == 'slider' %} tabindex="0"{% endif %}>
        <motion-list class="team-grid card-grid card-grid--{{ section.settings.columns }} mobile:card-grid--{{ section.settings.columns_mobile }} grid">
          {%- for block in section.blocks -%}
            {%- liquid
              assign name = block.settings.name
              assign role = block.settings.role
              assign image = block.settings.image
              assign link = block.settings.link
            -%}
            <div class="team-card" {{ block.shopify_attributes }}>
              {%- if link != blank -%}<a href="{{ link }}" class="block">{%- endif -%}

              <div class="team-card__media media media--{{ section.settings.image_ratio }}">
                {%- if image != blank -%}
                  {%- assign img_alt = name | escape -%}
                  {{- image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(max-width: 639px) 100vw, 25vw', alt: img_alt, is: 'lazy-image' -}}
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}

                {%- if section.settings.name_position == 'overlay' and name != blank -%}
                  <div class="team-card__overlay">
                    {%- if role != blank -%}
                      <div class="rounded-content w-fit">
                        <div class="rounded-content-inner">
                          <span class="team-card__role text-opacity">{{ role }}</span>
                        </div>
                      </div>
                    {%- endif -%}
                    <div class="rounded-content w-fit end">
                      <div class="rounded-content-inner">
                      <span class="team-card__overlay-name min-w-42">{{ name }}</span>
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              </div>

              {%- if section.settings.name_position == 'below' and name != blank -%}
                <div class="team-card__info">
                  {%- if role != blank -%}
                    <span class="team-card__role-below text-opacity">{{ role }}</span>
                  {%- endif -%}
                  <span class="team-card__name">{{ name }}</span>
                </div>
              {%- endif -%}

              {%- if link != blank -%}</a>{%- endif -%}
            </div>
          {%- endfor -%}
        </motion-list>

        {%- if section.settings.layout == 'slider' -%}
          <div class="indicators hidden lg:flex gap-2d5 items-center absolute top-0 left-0 w-full h-full pointer-events-none opacity-0 page-width">
            <button class="btn btn--secondary pointer-events-auto" type="button" is="previous-button" aria-controls="Slider-{{ section.id }}" aria-label="{{ 'general.pagination.previous' | t | escape }}" disabled>
              <span class="btn-text">{%- render 'icon', icon: 'chevron-left', class: 'stroke-2 transform' -%}</span>
            </button>
            <button class="btn btn--secondary pointer-events-auto" type="button" is="next-button" aria-controls="Slider-{{ section.id }}" aria-label="{{ 'general.pagination.next' | t | escape }}">
              <span class="btn-text">{%- render 'icon', icon: 'chevron-right', class: 'stroke-2 transform' -%}</span>
            </button>
          </div>
        {%- endif -%}
      </slider-element>
    {%- endif -%}
  </div>
</div>
{% stylesheet %}
.team-members-section .rounded-content .rounded-content-inner {
  padding: var(--sp-2) var(--sp-4) var(--sp-2) var(--sp-2);
}
{% endstylesheet %}
{% schema %}
{
  "name": "t:sections.team-members.name",
  "settings": [
    {
      "type": "header",
      "content": "t:sections.global.settings.header__heading.content"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:sections.global.settings.heading.label",
      "default": "Our Team"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "title-sm", "label": "t:sections.global.settings.heading_size.options__1.label" },
        { "value": "title-md", "label": "t:sections.global.settings.heading_size.options__2.label" },
        { "value": "title-lg tracking-heading", "label": "t:sections.global.settings.heading_size.options__3.label" },
        { "value": "title-xl tracking-heading", "label": "t:sections.global.settings.heading_size.options__4.label" }
      ],
      "default": "title-md",
      "label": "t:sections.global.settings.heading_size.label"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:sections.global.settings.heading_alignment.label",
      "options": [
        { "value": "text-left md:items-end md:flex-row", "label": "t:sections.global.settings.heading_alignment.options__1.label" },
        { "value": "text-center md:items-center", "label": "t:sections.global.settings.heading_alignment.options__2.label" },
        { "value": "text-right md:items-end md:flex-row-reverse", "label": "t:sections.global.settings.heading_alignment.options__3.label" }
      ],
      "default": "text-center md:items-center"
    },
    {
      "type": "select",
      "id": "heading_tag",
      "options": [
        { "value": "h1", "label": "t:sections.global.settings.heading_tag.options__1.label" },
        { "value": "h2", "label": "t:sections.global.settings.heading_tag.options__2.label" },
        { "value": "h3", "label": "t:sections.global.settings.heading_tag.options__3.label" }
      ],
      "default": "h2",
      "label": "t:sections.global.settings.heading_tag.label"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "t:sections.global.settings.subheading.label"
    },
    {
      "type": "header",
      "content": "t:sections.team-members.settings.header__layout.content"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:sections.team-members.settings.layout.label",
      "options": [
        { "value": "grid", "label": "t:sections.team-members.settings.layout.options__1.label" },
        { "value": "slider", "label": "t:sections.team-members.settings.layout.options__2.label" }
      ],
      "default": "grid"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:sections.team-members.settings.columns.label",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:sections.team-members.settings.columns_mobile.label",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:sections.global.settings.image_ratio.label",
      "options": [
        { "value": "adapt", "label": "t:sections.global.settings.image_ratio.options__1.label" },
        { "value": "square", "label": "t:sections.global.settings.image_ratio.options__2.label" },
        { "value": "portrait", "label": "t:sections.global.settings.image_ratio.options__3.label" },
        { "value": "landscape", "label": "t:sections.global.settings.image_ratio.options__4.label" }
      ],
      "default": "portrait"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "t:sections.team-members.settings.card_radius.label",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "name_position",
      "label": "t:sections.team-members.settings.name_position.label",
      "options": [
        { "value": "overlay", "label": "t:sections.team-members.settings.name_position.options__1.label" },
        { "value": "below", "label": "t:sections.team-members.settings.name_position.options__2.label" }
      ],
      "default": "overlay"
    },
    {
      "type": "header",
      "content": "t:settings.color"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "default": "scheme-1",
      "label": "t:settings.color_scheme"
    },
    {
      "type": "header",
      "content": "t:sections.global.settings.header__section.content"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "t:sections.global.settings.full_width.label",
      "default": false
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0, "max": 120, "step": 2, "unit": "px",
      "label": "t:sections.global.settings.padding_top.label",
      "default": 90
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0, "max": 120, "step": 2, "unit": "px",
      "label": "t:sections.global.settings.padding_bottom.label",
      "default": 90
    }
  ],
  "blocks": [
    {
      "type": "member",
      "name": "t:sections.team-members.blocks.member.name",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.team-members.blocks.member.settings.image.label"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:sections.team-members.blocks.member.settings.name.label",
          "default": "Full Name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "t:sections.team-members.blocks.member.settings.role.label",
          "default": "Co Founder"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.team-members.blocks.member.settings.link.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.team-members.presets.name",
      "category": "Image",
      "blocks": [
        { "type": "member", "settings": { "name": "Anthony Martinez", "role": "Co Founder" } },
        { "type": "member", "settings": { "name": "Elizabeth Johnson", "role": "Creative Director" } },
        { "type": "member", "settings": { "name": "Andrew Harris", "role": "Developer" } },
        { "type": "member", "settings": { "name": "Claire Thompson", "role": "Designer" } }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["footer", "header", "custom.overlay"]
  }
}
{% endschema %}
