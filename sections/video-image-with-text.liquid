<style>
  #shopify-section-{{ section.id }} {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
    {%- render 'section-variables', section: section -%}
    {%- if section.settings.image != blank and section.settings.image_height == 'adapt' %}
      --ratio-percent: {{ 1 | divided_by: section.settings.image.aspect_ratio | times: 100 }}%;
    {% endif -%}
  }

  {%- assign image_mobile = section.settings.image_mobile | default: section.settings.image -%}
  {%- if image_mobile != blank and section.settings.image_height_mobile == 'adapt' %}
    @media screen and (max-width: 767px) {
      #shopify-section-{{ section.id }} {
        --ratio-percent: {{ 1 | divided_by: image_mobile.aspect_ratio | times: 100 }}%;
      }
    }
  {% endif -%}
</style>
<div class="section section--padding color-{{ section.settings.color_scheme }}">
  <div class="page-width{% if section.settings.full_width %} page-width--full{% endif %} relative">
    {%- liquid
      assign with_background = false
      if section.settings.gradient_background_2 != blank and section.settings.gradient_background_2 != 'rgba(0,0,0,0)'
        assign with_background = true
      endif
      if section.settings.color_background_2 != blank and section.settings.color_background_2 != 'rgba(0,0,0,0)'
        assign with_background = true
      endif
    -%}
    <div class="image-with-text{% if with_background %} with-background{% endif %} lg:flex lg:gap-8{% if section.settings.layout == 'image_first' %} lg:flex-row{% else %} lg:flex-row-reverse{% endif %} overflow-hidden">
      <div class="image-with-text__item grow shrink-0{% if section.settings.image_width == 'small' %} lg:grow-0{% endif %} relative">
        <div class="image-with-text__media h-full">
          <media-element class="image-with-text__image block media--{{ section.settings.image_height }} mobile:media--{{ section.settings.image_height_mobile }} relative overflow-hidden"
            {%- if section.settings.enable_parallax %} data-parallax="0.3" data-parallax-dir="{{ section.settings.parallax_direction }}"{% endif -%}
          >
            <picture class="media media--height block w-full h-full relative overflow-hidden">
              {%- if section.settings.image != blank -%}
                {%- assign sizes = '(max-width: 1023px) 100vw, 74vw' -%}
                {%- if section.settings.image_mobile -%}
                  <source
                    media="(max-width: 767px)"
                    srcset="{{ section.settings.image_mobile | image_url: width: '400x' }} 400w, {{ section.settings.image_mobile | image_url: width: '600x' }} 600w, {{ section.settings.image_mobile | image_url: width: '800x' }} 800w, {{ section.settings.image_mobile | image_url: width: '1000x' }} 1000w"
                    width="{{ section.settings.image_mobile.width }}"
                    height="{{ section.settings.image_mobile.height }}"
                  >
                {%- endif -%}
  
                {{- section.settings.image | image_url: width: section.settings.image.width | image_tag: loading: 'lazy', sizes: sizes, widths: '300,400,500,600,700,800,900,1000,1200,1400,1600', is: 'lazy-image' -}}
              {%- else -%}
                {{- 'lifestyle-1' | placeholder_svg_tag: 'placeholder' -}}
              {%- endif -%}
            </picture>

            {%- if section.settings.video_url != blank or section.settings.video_file != blank -%}
              <button
                class="video-play-btn absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-18 h-18 rounded-full border-0 cursor-pointer flex items-center justify-center transition-transform duration-200 shadow-lg z-10"
                type="button"
                aria-controls="{{ section.id }}-video-modal"
                aria-label="{{ section.settings.play_button_label | default: 'Play video' | escape }}"
              >
                {%- render 'icon', icon: 'play', class: 'play-video' -%}
              </button>
            {%- endif -%}

            {%- if section.settings.video_caption_title != blank or section.settings.video_caption_subtitle != blank -%}
              <div class="absolute bottom-0 left-0 right-0 z-10">
                {%- if section.settings.video_label != blank -%}
                <div class="rounded-content w-fit">
                  <div class="rounded-content-inner"><p class="text-sm uppercase tracking-widest opacity-80">{{ section.settings.video_label }}</p></div>
                </div>
                {%- endif -%}
                {%- if section.settings.video_caption_title != blank -%}
                <div class="rounded-content w-fit end">
                    <div class="rounded-content-inner"><p class="text-2xl font-medium leading-snug">{{ section.settings.video_caption_title }}</p></div>
                </div>
                {%- endif -%}
              </div>
            {%- endif -%}

          </media-element>
        </div>
      </div>

      <div class="image-with-text__item flex flex-col grow shrink-0{% if section.settings.image_width == 'large' %} lg:grow-0{% endif %} {{ section.settings.content_position }}">
        <div class="rich-text flex flex-col {{ section.settings.content_horizontal_position }} text-{{ section.settings.text_alignment_mobile }} relative z-1">
          {%- liquid

            assign delay = 0
          -%}
          {% content_for 'blocks' %}
        </div>
      </div>
    </div>
  </div>
</div>

{%- if section.settings.video_url != blank or section.settings.video_file != blank -%}
  <nv-video-modal id="{{ section.id }}-video-modal" class="x-modal drawer z-30 fixed bottom-0 left-0 h-full w-full pointer-events-none"
    role="dialog"
    aria-modal="true"
    aria-label="{{ section.settings.video_caption_title | default: 'Video' | escape }}"
    data-video-url="{{ section.settings.video_url | escape }}"
    data-video-file="{{ section.settings.video_file.url | escape }}"
    hidden
  >
    <overlay-element class="overlay fixed-modal invisible opacity-0 fixed bottom-0 left-0 w-full h-screen pointer-events-none" aria-controls="{{ section.id }}-video-modal" aria-expanded="false"></overlay-element>
    <div class="drawer__inner z-10 absolute top-0 flex flex-col w-full h-full overflow-hidden">
      <div class="drawer__content opacity-0 invisible flex flex-col h-full grow shrink">
        <div class="relative flex items-center justify-center grow shrink">
          <div class="video-modal-player w-[90vw] max-w-[960px] aspect-video"></div>
        </div>
      </div>
    </div>
  </nv-video-modal>
{%- endif -%}
{% stylesheet %}
  .image-with-text .video-play-btn {
    background-color: rgb(var(--color-background));
    color: rgb(var(--color-foreground));
  }
@media(hover:hover)and (pointer:fine) {
    .image-with-text .video-play-btn:hover {
    background-color: rgb(var(--color-foreground));
    color: rgb(var(--color-background));

  }
}
{% endstylesheet %}
