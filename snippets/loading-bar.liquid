{%- doc -%}
  Renders a full-screen loading indicator with spinning animation.

  Creates a fixed overlay with centered spinner icon for page transitions or async operations.

  @example
  {% render 'loading-bar' %}
{%- enddoc -%}

<loading-bar class="loading-bar fixed top-0 left-0 w-full pointer-events-none" style="z-index: 9999;">
  <div class="loading-bar__progress"></div>
</loading-bar>
