{% doc %}
  Employee menu for the MAP login. Shows the signed-in employee's name with a dropdown (Employee ID, Log out).
  Auth state comes from window.MAP_AUTH (see map-auth-head). Hidden until a login is detected.

  @param {string} [variant] - 'header' (default, dropdown button) or 'drawer' (inline block for the mobile menu drawer).
{% enddoc %}

{%- unless request.design_mode -%}
  {%- if variant == 'drawer' -%}
    <div class="mem-drawer" data-mem="drawer" hidden>
      <p class="mem-drawer__name" data-mem-name></p>
      <p class="mem-drawer__id" data-mem-id-row hidden>Employee ID: <span data-mem-id></span></p>
      <button type="button" class="mem-drawer__logout" data-mem-logout>Logout</button>
    </div>
  {%- else -%}
    <div class="mem" data-mem="header" hidden>
      <button
        type="button"
        class="mem__trigger header-actions__action button-unstyled"
        aria-haspopup="true"
        aria-expanded="false"
        aria-controls="mem-panel"
        data-mem-trigger
      >
        <svg width="18" height="18" viewBox="0 0 15 17" fill="none" aria-hidden="true">
          <path stroke="currentColor" stroke-linejoin="round" stroke-width="1.2" d="M10.375 3.813a3.063 3.063 0 1 1-6.125 0 3.063 3.063 0 0 1 6.125 0ZM7.313 9.5c-3.667 0-6.24 2.691-6.563 6.125h13.125C13.552 12.191 10.979 9.5 7.312 9.5Z"/>
        </svg>
        <span class="mem__name" data-mem-name></span>
      </button>
      <div class="mem__panel color-scheme-1" id="mem-panel" data-mem-panel hidden>
        <p class="mem__label">Employee ID</p>
        <p class="mem__value" data-mem-id></p>
        <button type="button" class="mem__logout" data-mem-logout>Logout</button>
      </div>
    </div>
  {%- endif -%}

  <style>
    .mem[hidden], .mem__panel[hidden], .mem-drawer[hidden], .mem-drawer__id[hidden] { display: none !important; }
    .mem { position: relative; display: flex; align-items: center; }
    .mem__trigger { display: flex; align-items: center; gap: 8px; padding: 6px 8px; color: rgb(var(--color-foreground)); cursor: pointer; font: inherit; font-size: 0.875rem; }
    .mem__trigger:focus-visible { outline: 2px solid rgb(var(--color-keyboard-focus)); outline-offset: 3px; border-radius: var(--rounded-button, 8px); }
    .mem__name { max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .mem__panel { position: absolute; top: calc(100% + 10px); right: 0; z-index: 80; width: 260px; max-width: calc(100vw - 32px); box-sizing: border-box; padding: 16px; color: rgb(var(--color-foreground)); background: rgb(var(--color-background)); border: 1px solid rgb(var(--color-foreground) / .14); border-radius: var(--border-radius, 12px); box-shadow: 0 14px 32px rgb(0 0 0 / .14); opacity: 0; transform: translateY(-4px); transition: opacity 150ms ease, transform 150ms ease; }
    .mem__panel:not([hidden]) { opacity: 1; transform: translateY(0); }
    .mem__label { margin: 0 0 4px; color: rgb(var(--color-foreground) / .62); font-size: .75rem; line-height: 1.3; }
    .mem__value { max-width: 100%; margin: 0; overflow: hidden; color: rgb(var(--color-foreground)); font-size: .95rem; font-weight: 500; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
    .mem__panel::after { content: ''; display: block; height: 1px; margin: 14px 0; background: rgb(var(--color-foreground) / .12); }
    .mem__logout, .mem-drawer__logout { width: 100%; min-height: 44px; padding: 10px 14px; border: 1px solid rgb(var(--color-foreground) / .28); border-radius: var(--rounded-button, 8px); background: transparent; color: rgb(var(--color-foreground)); font: inherit; font-size: 0.875rem; font-weight: 500; cursor: pointer; }
    .mem__logout:hover, .mem-drawer__logout:hover { background: rgb(var(--color-foreground) / .08); }
    .mem__logout:focus-visible, .mem-drawer__logout:focus-visible { outline: 2px solid rgb(var(--color-keyboard-focus)); outline-offset: 2px; }
    .mem-drawer { margin-top: 24px; padding: 16px 18px; border: 1px solid rgb(var(--color-foreground) / .14); border-radius: var(--border-radius, 12px); color: rgb(var(--color-foreground)); background: rgb(var(--color-background)); }
    .mem-drawer__name { margin: 0; font-weight: 600; }
    .mem-drawer__id { margin: 4px 0 12px; color: rgb(var(--color-foreground) / .68); font-size: 0.875rem; }
    .mem-drawer__name + .mem-drawer__logout { margin-top: 12px; }
    @media screen and (max-width: 749px) {
      .mem__name { display: none; }
    }
    @media (prefers-reduced-motion: reduce) {
      .mem__panel { transition: none; }
    }
  </style>

  <script>
    (function () {
      if (window.__memInit) return;
      window.__memInit = true;

      function closeAll(returnFocus) {
        var openTrigger = null;
        document.querySelectorAll('[data-mem-panel]').forEach(function (p) { p.hidden = true; });
        document.querySelectorAll('[data-mem-trigger]').forEach(function (t) {
          if (t.getAttribute('aria-expanded') === 'true') openTrigger = t;
          t.setAttribute('aria-expanded', 'false');
        });
        if (returnFocus && openTrigger) openTrigger.focus();
      }

      function init() {
        if (!window.MAP_AUTH || !window.MAP_AUTH.isLoggedIn()) return;
        var emp = window.MAP_AUTH.getEmployee();
        document.querySelectorAll('[data-mem]:not([data-mem-ready])').forEach(function (root) {
          root.setAttribute('data-mem-ready', '');
          root.querySelectorAll('[data-mem-name]').forEach(function (el) { el.textContent = emp.name || 'Account'; });
          root.querySelectorAll('[data-mem-id]').forEach(function (el) { var id = emp.employeeId || '-'; el.textContent = id; el.title = id; });
          var row = root.querySelector('[data-mem-id-row]');
          if (row && emp.employeeId) row.hidden = false;
          root.hidden = false;
        });
      }

      document.addEventListener('click', function (e) {
        var trigger = e.target.closest('[data-mem-trigger]');
        if (trigger) {
          var panel = trigger.parentElement.querySelector('[data-mem-panel]');
          var open = panel.hidden;
          closeAll(false);
          panel.hidden = !open;
          trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
          return;
        }
        if (e.target.closest('[data-mem-logout]')) {
          window.mapLogout();
          return;
        }
        if (!e.target.closest('[data-mem-panel]')) closeAll(false);
      });

      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeAll(true); });

      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
      else init();

      // The mobile drawer markup can be inserted after load, so init late-added menus.
      // Login always reloads the page, so nothing to watch while logged out; and the callback only
      // does work when an added node actually is / contains an un-initialised menu.
      if (window.MAP_AUTH && window.MAP_AUTH.isLoggedIn()) {
        var SEL = '[data-mem]:not([data-mem-ready])';
        new MutationObserver(function (mutations) {
          for (var i = 0; i < mutations.length; i++) {
            var added = mutations[i].addedNodes;
            for (var j = 0; j < added.length; j++) {
              var n = added[j];
              if (n.nodeType === 1 && (n.matches(SEL) || n.querySelector(SEL))) { init(); return; }
            }
          }
        }).observe(document.body || document.documentElement, { childList: true, subtree: true });
      }
    })();
  </script>
{%- endunless -%}
