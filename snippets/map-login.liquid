<div id="map-login">
  <div class="map-login__card">
    {%- if settings.logo != blank -%}
      <img class="map-login__logo" src="{{ settings.logo | image_url: width: 400 }}" alt="{{ shop.name | escape }}" width="200">
    {%- endif -%}

    <h2 class="map-login__title">Employee Login</h2>
    <p class="map-login__sub">Log in with your Email, Employee ID or Ticket ID</p>

    <form id="map-login-form" novalidate>
      <label class="map-login__label" for="map-login-id">Email / Employee ID / Ticket ID</label>
      <input class="map-login__input" id="map-login-id" type="text" autocomplete="username" required>

      <label class="map-login__label" for="map-login-password">Password</label>
      <div class="map-login__pass">
        <input class="map-login__input" id="map-login-password" type="password" autocomplete="current-password" required>
        <button class="map-login__eye" id="map-login-eye" type="button" aria-label="Show password" aria-pressed="false">
          <svg class="map-login__eye-on" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
          <svg class="map-login__eye-off" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
        </button>
      </div>

      <p class="map-login__error" id="map-login-error" hidden></p>

      <button class="map-login__button" id="map-login-submit" type="submit">Log in</button>
    </form>
  </div>
</div>

<style>
  #map-login { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px 16px; background: #F6F7F9; font-family: Inter, system-ui, sans-serif; color: #111827; }
  .map-login__card { width: 100%; max-width: 420px; background: #fff; border: 1px solid #E5E7EB; border-top: 4px solid #F26B1D; border-radius: 12px; padding: 36px 28px; box-shadow: 0 12px 40px rgba(17,24,39,.14); }
  .map-login__logo { display: block; max-width: 180px; height: auto; margin: 0 auto 24px; }
  .map-login__title { text-align: center; margin: 0 0 4px; font-size: 24px; font-weight: 700; letter-spacing: -.01em; }
  .map-login__sub { text-align: center; margin: 0 0 24px; color: #4B5563; font-size: 14px; }
  .map-login__label { display: block; font-size: 13px; font-weight: 600; margin: 0 0 6px; }
  .map-login__input { width: 100%; box-sizing: border-box; padding: 12px; margin: 0 0 16px; border: 1px solid #D1D5DB; border-radius: 8px; font-size: 15px; font-family: inherit; color: #111827; background: #fff; }
  .map-login__input:focus { outline: 2px solid #C94F0C; outline-offset: 1px; border-color: #C94F0C; }
  .map-login__pass { position: relative; }
  .map-login__pass .map-login__input { padding-right: 44px; }
  .map-login__eye { position: absolute; top: 0; right: 0; height: 44px; width: 44px; display: flex; align-items: center; justify-content: center; background: none; border: 0; color: #4B5563; cursor: pointer; }
  .map-login__eye:hover { color: #111827; }
  .map-login__eye svg { display: block; }
  .map-login__eye .map-login__eye-off { display: none; }
  .map-login__eye.is-visible .map-login__eye-on { display: none; }
  .map-login__eye.is-visible .map-login__eye-off { display: block; }
  .map-login__error { color: #B91C1C; font-size: 13px; margin: 0 0 12px; }
  .map-login__button { width: 100%; padding: 14px; border: 0; border-radius: 8px; background: #C94F0C; color: #fff; font-weight: 600; font-size: 15px; font-family: inherit; cursor: pointer; }
  .map-login__button:hover { background: #A94009; }
  .map-login__button:disabled { opacity: .6; cursor: wait; }
</style>

<script>
  (function () {
    var LOGIN_URL = (window.MAP_API_BASE || '') + '/api/auth/login';

    var form = document.getElementById('map-login-form');
    var idInput = document.getElementById('map-login-id');
    var passInput = document.getElementById('map-login-password');
    var errorBox = document.getElementById('map-login-error');
    var button = document.getElementById('map-login-submit');

    var eye = document.getElementById('map-login-eye');
    eye.addEventListener('click', function () {
      var show = passInput.type === 'password';
      passInput.type = show ? 'text' : 'password';
      eye.setAttribute('aria-pressed', show);
      eye.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
      eye.classList.toggle('is-visible', show);
    });

    function showError(msg) {
      errorBox.textContent = msg;
      errorBox.hidden = false;
    }

    function resetButton() {
      button.disabled = false;
      button.classList.remove('is-loading');
      button.textContent = 'Log in';
    }

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      errorBox.hidden = true;

      var identifier = idInput.value.trim();
      var password = passInput.value;
      if (!identifier || !password) {
        showError('Please enter your login ID and password.');
        return;
      }

      if (!window.MAP_AUTH) {
        console.error('MAP login error: MAP_AUTH not found. Render map-auth-head in <head> of theme.liquid.');
        showError('Login setup error. Please contact support.');
        return;
      }

      if (button.disabled) return;
      button.disabled = true;
      button.classList.add('is-loading');
      button.textContent = 'Please wait...';

      var res;
      try {
        res = await fetch(LOGIN_URL, {
          method: 'POST',
          // x-thcm-loader is read and stripped by THCM_LOADER (snippets/thcm-loader.liquid) before the request is sent
          headers: Object.assign({
            'Content-Type': 'application/json',
            'ngrok-skip-browser-warning': 'true'
          }, window.THCM_LOADER ? window.THCM_LOADER.headers({ mode: 'overlay' }) : {}),
          body: JSON.stringify({ identifier: identifier, password: password })
        });
      } catch (err) {
        console.error('MAP login network/CORS error:', err);
        showError('Could not reach the server. Check the API URL and backend CORS settings.');
        resetButton();
        return;
      }

      try {
        var text = await res.text();
        var json;
        try {
          json = JSON.parse(text);
        } catch (parseErr) {
          console.error('MAP login: response is not JSON:', text.slice(0, 300));
          showError('Server returned an unexpected response.');
          return;
        }

        var data = json.data || {};
        if (!res.ok || !data.token) {
          showError(json.message || 'Invalid login details.');
          return;
        }

        window.MAP_AUTH.saveLogin(data.token, data.user || {});
        passInput.value = '';
        document.documentElement.classList.remove('map-locked');
      } catch (err) {
        console.error('MAP login error after response:', err);
        showError('Login failed: ' + err.message);
      } finally {
        resetButton();
      }
    });
  })();
</script>
