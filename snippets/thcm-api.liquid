{% doc %}
  THCM API helper (window.THCM_API). Single place for every storefront -> backend call.
  Requires map-auth-head (MAP_API_BASE, MAP_API_KEY, MAP_AUTH) to be rendered first in <head>.

  keyRequest(method, path, body, options) - sends x-api-key.
  jwtRequest(method, path, body, options) - sends Authorization: Bearer <employee token>.
  options (optional): { mode: 'overlay' } for user actions (default is the top progress bar), { silent: true } for background calls.
  The global loader (snippets/thcm-loader.liquid) shows itself for every call; nothing else is needed here.

  Both return a Promise:
    - resolves with the parsed JSON body ({} when empty)
    - resolves { denied: true } on 404 only for /api/admin/ routes or when the body message mentions access/permission;
      any other 404 rejects with an Error ("Not found...") so callers can show it with Retry
    - rejects with an Error (message is user-safe, .status holds the HTTP status when there is one)
    - on 401 calls MAP_AUTH.logout() and rejects with { handled: true }
{% enddoc %}

<script>
  window.THCM_API = (function () {
    function fail(message, status) {
      var err = new Error(message);
      if (status) err.status = status;
      return err;
    }

    function send(kind, method, path, body, options) {
      var headers = { 'ngrok-skip-browser-warning': 'true' };
      // Loader hints (x-thcm-*) are read and removed by THCM_LOADER before the request is sent
      var hints = window.THCM_LOADER ? window.THCM_LOADER.headers(options) : {};
      Object.keys(hints).forEach(function (k) { headers[k] = hints[k]; });

      if (kind === 'key') {
        headers['x-api-key'] = window.MAP_API_KEY || '';
      } else {
        var token = window.MAP_AUTH && window.MAP_AUTH.getToken();
        if (token) headers['Authorization'] = 'Bearer ' + token;
      }

      var opts = { method: method || 'GET', headers: headers };
      if (body !== undefined && body !== null) {
        headers['Content-Type'] = 'application/json';
        opts.body = JSON.stringify(body);
      }

      var url = (window.MAP_API_BASE || '') + path;

      return fetch(url, opts).then(
        function (res) {
          return res.text().then(function (text) {
            var json = null;
            try {
              json = text ? JSON.parse(text) : null;
            } catch (e) {
              console.error('THCM_API: response is not JSON (' + method + ' ' + path + '):', text.slice(0, 300));
            }

            if (res.status === 401) {
              console.error('THCM_API: 401 on ' + method + ' ' + path);
              if (window.MAP_AUTH) window.MAP_AUTH.logout();
              throw { handled: true, status: 401 };
            }
            if (res.status === 404) {
              console.error('THCM_API: 404 on ' + method + ' ' + path, json);
              // The backend hides admin routes from non-admins with a 404, so only treat it as "denied"
              // for admin routes or when the body says so. Any other 404 is a real "not found".
              var msg = (json && json.message) || '';
              if (/^\/api\/admin\//.test(path) || /access|permission|forbidden|not authori[sz]ed|admin/i.test(msg)) {
                return { denied: true };
              }
              throw fail(msg || 'Not found (404). The requested data or server route does not exist.', 404);
            }
            if (!res.ok) {
              console.error('THCM_API: ' + res.status + ' on ' + method + ' ' + path, json);
              throw fail((json && json.message) || ('Request failed (' + res.status + ')'), res.status);
            }
            return json || {};
          });
        },
        function (err) {
          console.error('THCM_API network/CORS error (' + method + ' ' + path + '):', err);
          throw fail('Server not reachable. Please check your connection and try again.');
        }
      );
    }

    return {
      keyRequest: function (method, path, body, options) { return send('key', method, path, body, options); },
      jwtRequest: function (method, path, body, options) { return send('jwt', method, path, body, options); }
    };
  })();
</script>
