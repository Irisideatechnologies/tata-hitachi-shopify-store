{
  "sections": {
    "main-product": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "icon": "none",
            "icon_width": 20,
            "text": "{{ product.vendor }}",
            "text_size": "text-base"
          }
        },
        "title": {
          "type": "title",
          "settings": {
            "title_size": "product-title-md",
            "title_size_mobile": "product-title-md",
            "title_tag": "h1",
            "show_price": true,
            "show_rating": true
          }
        },
        "description": {
          "type": "description",
          "settings": {
            "text_size": "text-base"
          }
        },
        "countdown": {
          "type": "countdown",
          "settings": {
            "heading": "Hurry up!",
            "subheading": "Sale end in:",
            "color_text": "#e11d48",
            "color_background": "#fff1f2",
            "gradient_background": ""
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "show_variant_labels": true,
            "picker_type": "button",
            "enable_color_swatches": true,
            "color_swatch_type": "variant",
            "size_chart": ""
          }
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "inventory_threshold": 15,
            "show_inventory_transfer": true,
            "show_inventory_quantity": "low",
            "color_scheme": "accent-1"
          }
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_quantity_selector": true,
            "show_price": true,
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true,
            "enable_back_in_stock": true,
            "show_back_in_stock_name": true,
            "show_back_in_stock_phone": true
          }
        },
        "pickup_availability": {
          "type": "pickup_availability",
          "settings": {}
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share",
            "show_help_desk": true,
            "help_label": "Need help?",
            "help_type": "drawer",
            "help_page": ""
          }
        },
        "complementary": {
          "type": "complementary",
          "settings": {
            "heading": "Pairs well with",
            "product_limit": 4,
            "show_vendor": false,
            "show_price": true
          }
        },
        "text-1": {
          "type": "text",
          "settings": {
            "icon": "truck",
            "icon_width": 20,
            "text": "In stock! Ships within 1-2 business days.",
            "text_size": "text-sm"
          }
        },
        "text-2": {
          "type": "text",
          "settings": {
            "icon": "headphone",
            "icon_width": 20,
            "text": "90-day risk-free trial",
            "text_size": "text-sm"
          }
        },
        "text-3": {
          "type": "text",
          "settings": {
            "icon": "award",
            "icon_width": 20,
            "text": "2-Year Warranty",
            "text_size": "text-sm"
          }
        },
        "text-4": {
          "type": "text",
          "settings": {
            "icon": "box",
            "icon_width": 20,
            "text": "Complimentary shipping & returns",
            "text_size": "text-sm"
          }
        },
        "sticky_buy_button": {
          "type": "sticky_buy_button",
          "settings": {}
        }
      },
      "block_order": [
        "vendor",
        "title",
        "description",
        "countdown",
        "variant_picker",
        "inventory",
        "buy_buttons",
        "pickup_availability",
        "share",
        "complementary",
        "text-1",
        "text-2",
        "text-3",
        "text-4",
        "sticky_buy_button"
      ],
      "settings": {
        "enable_sticky_info": true,
        "media_size": 66,
        "gallery_layout": "scroll",
        "thumbnail_position": "beside",
        "image_ratio": "adapt_first",
        "image_zoom": "lightbox",
        "hide_variants": false,
        "enable_video_autoplay": true,
        "enable_video_looping": true,
        "mobile_layout": "full_width",
        "image_ratio_mobile": "adapt_first",
        "mobile_thumbnail": false,
        "padding_top": 0,
        "padding_bottom": 84,
        "divider": false,
        "full_width": true,
        "rounded": false
      }
    }
  },
  "order": [
    "main-product"
  ]
}